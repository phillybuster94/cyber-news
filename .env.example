# Copy to .env (git-ignored) and fill in the values for your remote Elasticsearch; see the README.
# docker compose (env_file) and docker run --env-file read this file. Write one VAR=value per line, with
# no quotes and no inline comments (docker run --env-file keeps them as part of the value).
# Do not leave a variable set but empty: variables with a default reject a blank value; comment it out.

# --- Elasticsearch connection (required) -------------------------------------------------------------------
# Comma-separated http(s)://host[:port] URLs of the remote cluster, without credentials. Hosted services
# usually listen on 443 (e.g. https://my-deployment.es.eu-west-1.aws.elastic-cloud.com:443).
# Default http://localhost:9200 is the container itself, so always set it.
ES_HOSTS=https://es.example.com:9200

# --- Authentication: an API key (recommended) or basic auth, not both ------------------------------------------
# API key, the base64 "encoded" value. Prefer the *_FILE form: the file is mounted from ./secrets by
# docker-compose.override.yml.
ES_API_KEY_FILE=/run/secrets/es_api_key
# ES_API_KEY=

# Basic auth: set both or neither; the password can also come from a file.
# ES_USERNAME=cyber-news-reader
# ES_PASSWORD_FILE=/run/secrets/es_password
# ES_PASSWORD=

# --- TLS ---------------------------------------------------------------------------------------------------
# CA bundle that signed the cluster's certificate (https hosts only), as seen inside the container. Needed for
# a private or self-signed CA; comment it out when the certificate is signed by a public CA.
ES_CA_CERTS=/certs/ca.crt
# Verify the cluster's certificate: true/false/1/0/yes/no. Default: true. Keep it true; use ES_CA_CERTS instead.
# ES_VERIFY_CERTS=true
# Request timeout in seconds, greater than 0. Default: 10. Raise it for a slow or distant cluster.
# ES_REQUEST_TIMEOUT=10

# --- Index -------------------------------------------------------------------------------------------------
# Index, alias or pattern that holds the news. Default: cyber-news
ES_INDEX=cyber-news

# Field names in the index (dotted paths address nested fields, e.g. meta.published_at). Defaults shown.
# NEWS_FIELD_TITLE=title
# NEWS_FIELD_DESCRIPTION=description
# NEWS_FIELD_LINK=link
# NEWS_FIELD_PUBLISHED=published

# --- App ---------------------------------------------------------------------------------------------------
# IANA time zone that defines "today" and the day boundaries. Default: Europe/Bucharest
# APP_TIMEZONE=Europe/Bucharest
